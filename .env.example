# ==============================================================================
# CONFIGURACIÓN — Hogar, Tareas Compartidas
# ==============================================================================

# Cadena de conexión a PostgreSQL.
# En Coolify: crea un recurso PostgreSQL y copia su "Internal Connection URL"
# (usa el nombre del servicio como host, no localhost).
#
# En local con docker-compose.yml:
DATABASE_URL=postgresql://hogar:hogar@localhost:5432/hogar
#
# En local con `npm run db:local` (PGlite, sin Docker):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Zona horaria. Determina qué día es "hoy" para la app. Sin esto el contenedor
# se queda en UTC y el día cambia a medianoche de Londres.
TZ=Europe/Madrid

NEXT_TELEMETRY_DISABLED=1

# Máximo de conexiones del pool. Déjalo sin poner salvo que tu PostgreSQL tenga
# pocas conexiones disponibles.
# DATABASE_POOL_MAX=5
