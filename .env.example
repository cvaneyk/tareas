# ==============================================================================
# CONFIGURACIÓN DE BASE DE DATOS PARA COOLIFY / SERVIDOR
# Copia estos valores con los datos de la base de datos creada en Coolify
# ==============================================================================

# Tipo de base de datos: mysql o pgsql (PostgreSQL)
DB_TYPE=mysql

# Host o IP de la base de datos (En Coolify suele ser el nombre del servicio o localhost)
DB_HOST=localhost
DB_PORT=3306

# Nombre de la base de datos creada en Coolify
DB_NAME=hogar_db

# Usuario y Contraseña
DB_USER=root
DB_PASS=tu_contraseña_secreta

# Alternativa: URL completa de conexión si Coolify te proporciona DATABASE_URL
# DATABASE_URL=mysql://root:tu_contraseña@localhost:3306/hogar_db
# DATABASE_URL=postgres://postgres:tu_contraseña@localhost:5432/hogar_db
